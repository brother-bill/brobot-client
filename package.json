{
    "name": "@singularity/brobot-client",
    "version": "1.0.0",
    "private": true,
    "description": "brobot's streamer desktop app for Windows: lives in the tray, obeys !chatban / !voiceban from the bot by blocking Enter and muting the microphone.",
    "main": "dist/electron/main.js",
    "author": "Brother Bill",
    "scripts": {
        "dev": "concurrently -k -n RENDERER,ELECTRON -c cyan,magenta \"pnpm run dev:renderer\" \"pnpm run dev:electron\"",
        "dev:renderer": "ng serve --port 4206 --host 127.0.0.1",
        "dev:electron": "wait-on tcp:127.0.0.1:4206 && node electron/esbuild.mjs --watch",
        "build": "pnpm run build:electron && pnpm run build:renderer",
        "build:renderer": "ng build",
        "build:electron": "node electron/esbuild.mjs",
        "package": "pnpm run build && electron-builder --win --dir",
        "dist": "pnpm run build && electron-builder --win",
        "lint": "eslint .",
        "test": "ng test --watch=false",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.spec.json",
        "gen:theme": "node ../../libs/ngx-ui/scripts/generate-theme.mjs --config renderer/src/brand.config.json --out renderer/src/generated-colors.scss"
    },
    "dependencies": {
        "@angular/aria": "catalog:",
        "@angular/cdk": "catalog:",
        "@angular/common": "catalog:",
        "@angular/compiler": "catalog:",
        "@angular/core": "catalog:",
        "@angular/forms": "catalog:",
        "@angular/platform-browser": "catalog:",
        "@angular/router": "catalog:",
        "@ngx-translate/core": "^16.0.4",
        "@singularity/ngx-ui": "workspace:*",
        "rxjs": "catalog:",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/ws": "^8.5.12",
        "electron": "^44.4.3",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2"
    }
}
