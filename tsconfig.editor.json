{
    "extends": "../../tsconfig.angular.json",
    "compilerOptions": {
        // shared/streamer-events.ts is brobot's wire contract copied byte for
        // byte (so the two copies can be diffed), and brobot does not set this
        // style flag; its dot access on a Record would not compile here.
        "noPropertyAccessFromIndexSignature": false,
        "types": ["node"],
        "lib": ["es2023", "dom", "dom.iterable"],
        "baseUrl": "../../",
        "moduleResolution": "bundler",
        "paths": {
            "@singularity/ngx-ui": ["libs/ngx-ui/src/index.ts"],
            "@singularity/ngx-ui/styles": ["libs/ngx-ui/src/lib/styles/index.scss"],
            "@brobot-client/shared": ["apps/brobot-client/shared/index.ts"]
        }
    },
    "include": ["renderer/src/**/*.ts", "shared/**/*.ts", "electron/**/*.ts"]
}
